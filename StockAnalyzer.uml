        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hKM1ENaQEeOkF46DsrI2bQ" name="getS1" specification="_hAHsANaQEeOkF46DsrI2bQ">
          <ownedParameter xmi:id="_hKM1EdaQEeOkF46DsrI2bQ" name="i">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
