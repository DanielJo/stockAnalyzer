//		currentClose = Double.parseDouble(ParseCsv.stockList.get(i).getClose().replace(&quot;,&quot;, &quot;.&quot;));&#xD;
		&#xD;
		pp_pp = (currentHigh + currentLow + currentClose) / 3;&#xD;
		ParseCsv.stockList.get(i).setPP_pp(pp_pp);&#xD;
		PP_PP.add(pp_pp);&#xD;
		pp_pp_l.add(pp_pp);&#xD;
	</body>
