				int slow = extractValueI(3, arguments);&#xD;
				int smooth = extractValueI(4, arguments);&#xD;
				WriteCsv.indicators.add(&quot;MACD_&quot; + fast + &quot;_&quot; + slow + &quot;_&quot;&#xD;
