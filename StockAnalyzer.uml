          <ownedParameter xmi:id="_hKJKs9aQEeOkF46DsrI2bQ" name="currentLow">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#double"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKJKtNaQEeOkF46DsrI2bQ" name="currentClose">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#double"/>
          </ownedParameter>
          <language>java</language>
          <body>//		currentHigh = RVI.High.get(i);&#xD;
//		currentLow = RVI.Low.get(i);&#xD;
//		currentClose = RVI.Close.get(i);&#xD;
//		currentHigh = Double.parseDouble(ParseCsv.stockList.get(i).getHigh().replace(&quot;,&quot;, &quot;.&quot;));&#xD;
