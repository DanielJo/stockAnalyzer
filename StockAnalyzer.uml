        <ownedAttribute xmi:id="_hDcFwNaQEeOkF46DsrI2bQ" name="con" visibility="private" isStatic="true" type="_g9AGkNaQEeOkF46DsrI2bQ" association="_hPKNkdaQEeOkF46DsrI2bQ">
