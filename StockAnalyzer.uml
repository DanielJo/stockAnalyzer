          <ownedParameter xmi:id="_hKkohNaQEeOkF46DsrI2bQ" name="open">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkohdaQEeOkF46DsrI2bQ" name="high">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkohtaQEeOkF46DsrI2bQ" name="low">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkoh9aQEeOkF46DsrI2bQ" name="close">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkoiNaQEeOkF46DsrI2bQ" name="volume">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkoidaQEeOkF46DsrI2bQ" type="_gf3eoNaQEeOkF46DsrI2bQ" direction="return"/>
          <language>java</language>
          <body>super();&#xD;
		DateTime = dateTime;&#xD;
		Symbol = symbol;&#xD;
		Intervall = intervall;&#xD;
		Open = Double.parseDouble(open.replace(&quot;,&quot;, &quot;.&quot;));&#xD;
		High = Double.parseDouble(high.replace(&quot;,&quot;, &quot;.&quot;));&#xD;
		Low = Double.parseDouble(low.replace(&quot;,&quot;, &quot;.&quot;));&#xD;
		Close = Double.parseDouble(close.replace(&quot;,&quot;, &quot;.&quot;));&#xD;
		Volume = Integer.parseInt(volume.replace(&quot;.&quot;, &quot;&quot;).replace(&quot; &quot;, &quot;&quot;)&#xD;
				.replace(&quot;-&quot;, &quot;0&quot;));&#xD;
		RVI = 0.;&#xD;
		RVI_Difference = 0.;&#xD;
		ZZ_Point = 0;&#xD;
		ZZ_Value = 0.;&#xD;
	</body>
        </ownedBehavior>
        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hKmdsNaQEeOkF46DsrI2bQ" name="Stock" specification="_ggH9UNaQEeOkF46DsrI2bQ">
