          <body>super();&#xD;
		TALibCalls.open = open;&#xD;
		TALibCalls.close = close;&#xD;
		TALibCalls.high = high;&#xD;
		TALibCalls.low = low;&#xD;
		TALibCalls.volume = volume2;&#xD;
&#xD;
