          <ownedParameter xmi:id="_hKM1EtaQEeOkF46DsrI2bQ" name="currentHigh" type="_hAF20daQEeOkF46DsrI2bQ"/>
          <language>java</language>
          <body>//currentHigh = RVI.High.get(i);&#xD;
		pp_s1 = (2 * PP_PP.get(i) - currentHigh);&#xD;
