        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hKkogNaQEeOkF46DsrI2bQ" name="Stock" specification="_ggDr4NaQEeOkF46DsrI2bQ">
          <ownedParameter xmi:id="_hKkogdaQEeOkF46DsrI2bQ" name="dateTime">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkogtaQEeOkF46DsrI2bQ" name="symbol">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
          <ownedParameter xmi:id="_hKkog9aQEeOkF46DsrI2bQ" name="intervall">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
