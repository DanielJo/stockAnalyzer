        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hKcssNaQEeOkF46DsrI2bQ" name="testOwnMethod" specification="_gexScNaQEeOkF46DsrI2bQ">
          <language>java</language>
          <body>StringBuilder b = new StringBuilder();&#xD;
		long start = System.currentTimeMillis();&#xD;
		for (int i = 0; i &lt; test.size(); i++){&#xD;
			appendTo2(b, test.get(i));&#xD;
			if (i % 500 == 0){&#xD;
				//System.out.println(b.toString() + &quot;_&quot; + test.get(i));&#xD;
			}&#xD;
		}&#xD;
		System.out.println(&quot;OwnMethod Durchlauf Nr.&quot; + k + &quot; :&quot; +  (System.currentTimeMillis() - start) + &quot;ms&quot;);&#xD;
		k++;&#xD;
	</body>
        </ownedBehavior>
        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hKcssdaQEeOkF46DsrI2bQ" name="appendTo2" specification="_hAgtkNaQEeOkF46DsrI2bQ">
          <ownedParameter xmi:id="_hKcsstaQEeOkF46DsrI2bQ" name="builder" type="_hAe4YNaQEeOkF46DsrI2bQ"/>
          <ownedParameter xmi:id="_hKcss9aQEeOkF46DsrI2bQ" name="d">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#double"/>
          </ownedParameter>
          <language>java</language>
          <body>builder.setLength(0);&#xD;
	    if (d &lt; 0) {&#xD;
	        builder.append('-');&#xD;
	        d = -d;&#xD;
	    }&#xD;
	    long scaled = (long) (d * 1e6 + 0.5);&#xD;
	    long factor = 1000000;&#xD;
	    int scale = 3;&#xD;
	    while (factor * 10 &lt;= scaled) {&#xD;
	        factor *= 10;&#xD;
	        scale++;&#xD;
	    }&#xD;
	    while (scale > 0) {&#xD;
	        if (scale == 2)&#xD;
	            builder.append(',');&#xD;
	        long c = scaled / factor % 10;&#xD;
	        factor /= 10;&#xD;
	        builder.append((char) ('0' + c));&#xD;
	        scale--;&#xD;
	    }&#xD;
	</body>
        </ownedBehavior>
