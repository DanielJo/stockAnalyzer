        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hKcFotaQEeOkF46DsrI2bQ" name="testDecimalFormat" specification="_gewrYNaQEeOkF46DsrI2bQ">
          <language>java</language>
          <body>long start = System.currentTimeMillis();&#xD;
		for (int i = 0; i &lt; test.size(); i++){&#xD;
		String testString = f.format(test.get(i));&#xD;
		}&#xD;
		System.out.println(&quot;DecimalFormat Durchlauf Nr.&quot; + j + &quot; :&quot; + (System.currentTimeMillis() - start) + &quot;ms&quot;);&#xD;
